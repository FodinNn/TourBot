[Unit]
Description=TourBot — гид по Казани для MAX
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tourbot
Group=tourbot
WorkingDirectory=/opt/tourbot
EnvironmentFile=/etc/tourbot.env
Environment=BOT_LOCK_FILE=/var/lib/tourbot/bot.lock
ExecStart=/opt/tourbot/tourbot
Restart=always
RestartSec=5
StateDirectory=tourbot
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tourbot

[Install]
WantedBy=multi-user.target
